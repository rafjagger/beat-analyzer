# =============================================================================
# Beat Analyzer Konfiguration
# =============================================================================
# The package copies this to ~/.config/beat-analyzer/beat-analyzer.env on the
# first start and never writes over it. In a checkout: cp .env.example build/.env
# Files in ~/.config/beat-analyzer/conf.d/*.env are read after it; a later
# file wins key by key.

# --- Audio -------------------------------------------------------------------

JACK_CLIENT_NAME=beat-analyzer
NUM_BPM_CHANNELS=1              # JACK Ports: bpm_1 (Beat-Erkennung)
NUM_VU_CHANNELS=56              # JACK ports vu_analog1_L .. vu_in4_post_R; which REAPER out feeds which one is the patchbay's call, see the OSC truth (a3-osc.json, vu meaning)
BPM_MIN=60
BPM_MAX=140
TAP_LOCK_BARS=16                # a tap fixes the tempo for this many bars, then detection follows the music again; 0 = until restart

# --- OSC Ausgabe -------------------------------------------------------------

# Where /beat and /vu go -- the OSC_HOST_*/OSC_VU_* targets -- is not written
# here: see the a3-osc block at the end. An OSC_VU_ target takes the meters
# instead of the OSC_HOST_ one of the same name.

# Sende-Rate für VU-Bundles (Hz, 1-100)
OSC_SEND_RATE=25

# --- Pioneer Pro DJ Link ----------------------------------------------------

# Virtual CDJ Device-Nummer (7 = Standard, vermeidet Konflikt mit CDJ 1-4)
# Die Pro-DJ-Link-Ports kommen aus dem a3-osc-Block (siehe unten).
PIONEER_DEVICE_NUM=7

# --- Clock-Modus (wird zur Laufzeit via /clockmode umgeschaltet) ------------
#   0 = a3motion: /beat von Port 7775 empfangen, weiterleiten an alle AUSSER motion
#   1 = intern:   Eigene Beatclock (BTrack + Synthclock), senden an alle Ziele
#   2 = pioneer:  Beat vom Pioneer DJ Link Master, weiterleiten an alle Ziele

# --- VU-Meter ----------------------------------------------------------------

VU_RMS_ATTACK=0.8               # 0.0-1.0 (höher = schnellere Reaktion)
VU_RMS_RELEASE=0.2              # 0.0-1.0 (höher = schnellerer Abfall)
# The peak is sent raw (highest sample since the last send); the displays
# apply the fall and the hold. VU_PEAK_FALLOFF is gone and ignored if set.

# --- Features ----------------------------------------------------------------

ENABLE_BEATCLOCK=1
ENABLE_BEAT=1
ENABLE_VU=1

# --- Debug -------------------------------------------------------------------

LOG_LEVEL=1                     # 0=DEBUG 1=INFO 2=WARN 3=ERROR
DEBUG_BEAT_CONSOLE=1            # BEAT 1 | BPM 120.0 | delta ...
DEBUG_BTRACK_CONSOLE=0          # BTRACK_BEAT: delta=... bpm_raw=...
DEBUG_PIONEER_CONSOLE=0         # PIONEER_BEAT 1 | BPM 120.0 ...
DEBUG_VU_CONSOLE=0

# --- Targets ------------------------------------------------------------------
# Where /beat goes: OSC_HOST_<name>=host:port, as many as you like; the meters
# go to OSC_VU_<name>=host:port instead where one is set. None is set here:
# without a target the analyzer runs and sends nothing.
#
# On an A3 Core the a3-core package writes the targets, the receive port, the
# addresses and the Pro DJ Link ports from its one truth (a3-osc.json) into
# ~/.config/beat-analyzer/conf.d/50-a3-osc.env (a3-osc-render user). Do not set
# them here as well. See README, "Addresses and ports".
