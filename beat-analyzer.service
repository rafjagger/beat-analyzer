[Unit]                                                                                     
Description=beat-analyzer (bpm & vu-meters)
PartOf=a3-main.service
After=a3-jack.service

[Service]
Type=idle
#PrivateTmp=true
WorkingDirectory=/home/aaa/beat-analyzer/build
ExecStartPre=/bin/sleep 2
ExecStart=/home/aaa/beat-analyzer/build/beat-analyzer
CPUAffinity=1 2 3
# No real-time for the whole process: it put the OSC and BTrack threads above
# JACK's and made JACK report late clients. JACK raises its process thread.

[Install]
WantedBy=default.target
