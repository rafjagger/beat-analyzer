#!/bin/sh
# The user's config from the shipped example, once:
#
#   beat-analyzer-seed <config dir> [example]
#
# Creates <config dir>/beat-analyzer.env if there is none and never writes over
# one: it is the user's file from the first start on. Also makes conf.d/, where
# another package may put a whole file of its own (a3-core: 50-a3-osc.env).
set -eu

dir=${1:?usage: beat-analyzer-seed <config dir> [example]}
example=${2:-/usr/share/beat-analyzer/beat-analyzer.env.example}

mkdir -p "$dir/conf.d"
if [ ! -e "$dir/beat-analyzer.env" ] && [ -f "$example" ]; then
    cp "$example" "$dir/beat-analyzer.env"
    echo "beat-analyzer: wrote $dir/beat-analyzer.env from $example"
fi
